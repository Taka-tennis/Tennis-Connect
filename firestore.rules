rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function reservationStudent() {
      return signedIn()
        && ('studentId' in resource.data)
        && resource.data.studentId == request.auth.uid;
    }

    function reservationCoach() {
      return signedIn()
        && ('coachId' in resource.data)
        && resource.data.coachId == request.auth.uid;
    }

    // 生徒プロフィール：本人だけ
    match /students/{studentId} {
      allow create, read, update, delete:
        if signedIn() && request.auth.uid == studentId;

      match /{document=**} {
        allow read, write:
          if signedIn() && request.auth.uid == studentId;
      }
    }

    // コーチプロフィール：閲覧は公開、編集は本人だけ
    match /coaches/{coachId} {
      allow read: if true;

      allow create:
        if signedIn() && request.auth.uid == coachId;

      allow update:
        if signedIn()
        && request.auth.uid == coachId
        && !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'rating',
            'ratingAverage',
            'ratingCount',
            'ratingSum',
            'reviewCount'
          ]);

      allow delete:
        if signedIn() && request.auth.uid == coachId;
    }

    // 空き日程
    match /coachAvailability/{coachId}/dates/{dateId} {
      allow read: if true;

      allow write:
        if signedIn()
        && request.auth.uid == coachId;
    }

    // 予約
    match /reservations/{reservationId} {

      allow create: if false;

      allow read:
        if reservationStudent() || reservationCoach();

      // クライアントからの更新は担当コーチの承認・却下のみ
      allow update:
        if reservationCoach()
        && resource.data.status == 'pending'
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.coachId == resource.data.coachId
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['confirmed', 'rejected'];

      allow delete: if false;
    }

    // 1対1チャット
    match /messages/{messageId} {

      allow read:
        if signedIn()
        && (
          (
            ('studentId' in resource.data)
            && resource.data.studentId == request.auth.uid
          )
          ||
          (
            ('coachId' in resource.data)
            && resource.data.coachId == request.auth.uid
          )
        );

      allow create:
        if signedIn()
        && ('studentId' in request.resource.data)
        && ('coachId' in request.resource.data)
        && ('senderId' in request.resource.data)
        && request.resource.data.senderId == request.auth.uid
        && ('sender' in request.resource.data)
        && (
          (
            request.resource.data.sender == 'user'
            && request.resource.data.studentId == request.auth.uid
          )
          ||
          (
            request.resource.data.sender == 'coach'
            && request.resource.data.coachId == request.auth.uid
          )
        );

      // 相手から届いたメッセージの未読→既読だけ許可
      allow update:
        if signedIn()
        && (
          (
            resource.data.sender == 'coach'
            && resource.data.studentId == request.auth.uid
          )
          ||
          (
            resource.data.sender == 'user'
            && resource.data.coachId == request.auth.uid
          )
        )
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['isRead'])
        && resource.data.isRead == false
        && request.resource.data.isRead == true;

      allow delete: if false;
    }

    // アプリ内通知
    match /notifications/{notificationId} {

      // コーチ→生徒：予約承認・却下通知
      allow create:
        if signedIn()
        && ('type' in request.resource.data)
        && ('recipientId' in request.resource.data)
        && ('reservationId' in request.resource.data)
        && ('coachId' in request.resource.data)
        && request.resource.data.type in [
          'reservationApproved',
          'reservationRejected'
        ]
        && request.resource.data.coachId == request.auth.uid
        && get(
          /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
        ).data.coachId == request.auth.uid
        && get(
          /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
        ).data.studentId == request.resource.data.recipientId;

      allow read:
        if signedIn()
        && ('recipientId' in resource.data)
        && resource.data.recipientId == request.auth.uid;

      allow update:
        if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['isRead'])
        && resource.data.isRead == false
        && request.resource.data.isRead == true;

      allow delete: if false;
    }

    // レビュー：公開閲覧。
    // 投稿・評価集計はCloud Functions側で行う。
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // お気に入り：本人のデータだけ
    match /favorites/{favoriteId} {
      allow create:
        if signedIn()
        && request.resource.data.keys().hasAll([
          'studentId',
          'coachId',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentId',
          'coachId',
          'createdAt'
        ])
        && request.resource.data.studentId == request.auth.uid;

      allow read, delete:
        if signedIn()
        && ('studentId' in resource.data)
        && resource.data.studentId == request.auth.uid;

      allow update: if false;
    }

    // ブロック：ブロックした本人だけが自分のブロック情報を扱える
    match /blocks/{blockId} {

      // 一覧・状態確認は blockerId == 自分 のデータだけ
      allow read:
        if signedIn()
        && ('blockerId' in resource.data)
        && resource.data.blockerId == request.auth.uid;

      allow create:
        if signedIn()
        && request.resource.data.keys().hasAll([
          'blockerId',
          'blockedUserId',
          'blockedRole',
          'source',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'blockerId',
          'blockedUserId',
          'blockedRole',
          'source',
          'createdAt'
        ])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid
        && request.resource.data.blockedRole == 'coach'
        && request.resource.data.source == 'coachDetail'
        && request.resource.data.createdAt == request.time
        && blockId
          == request.auth.uid
            + '__'
            + request.resource.data.blockedUserId;

      // 同じブロックを再保存する場合でも、
      // 対象ユーザーや所有者は変更させない
      allow update:
        if signedIn()
        && ('blockerId' in resource.data)
        && resource.data.blockerId == request.auth.uid
        && request.resource.data.blockerId == resource.data.blockerId
        && request.resource.data.blockedUserId == resource.data.blockedUserId
        && request.resource.data.blockedRole == resource.data.blockedRole
        && request.resource.data.source == resource.data.source
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;

      allow delete:
        if signedIn()
        && ('blockerId' in resource.data)
        && resource.data.blockerId == request.auth.uid;
    }

    // 通報：ログイン中の本人が新規通報を送信する場合のみ許可
    // 利用者側から通報データを読み返したり変更したりはできない
    match /reports/{reportId} {
      allow create:
        if signedIn()
        && request.resource.data.keys().hasAll([
          'reporterId',
          'reportedUserId',
          'reportedRole',
          'reason',
          'source',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'reporterId',
          'reportedUserId',
          'reportedRole',
          'reason',
          'source',
          'status',
          'createdAt',
          'details'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.reportedRole == 'coach'
        && request.resource.data.reason in [
          '不適切なプロフィール・投稿',
          '迷惑行為・嫌がらせ',
          '虚偽の情報・なりすまし',
          '予約・レッスンに関する問題',
          'その他'
        ]
        && request.resource.data.source == 'coachDetail'
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && (
          !('details' in request.resource.data)
          ||
          (
            request.resource.data.details is string
            && request.resource.data.details.size() <= 1000
          )
        );

      allow read, update, delete: if false;
    }

    // お問い合わせ：ログイン中の本人が新規送信する場合のみ許可
    match /inquiries/{inquiryId} {
      allow create:
        if signedIn()
        && request.resource.data.keys().hasAll([
          'userId',
          'email',
          'category',
          'message',
          'status',
          'appVersion',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId',
          'email',
          'category',
          'message',
          'status',
          'appVersion',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.category in [
          '予約について',
          '支払い・返金について',
          'コーチについて',
          'アカウントについて',
          'その他'
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.appVersion is string
        && request.resource.data.createdAt == request.time;

      // 利用者側からの閲覧・変更・削除は許可しない
      allow read, update, delete: if false;
    }

    // 明示していないコレクションは拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
